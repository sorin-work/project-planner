# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5451
API_PORT=4411
WEB_PORT=5191

# Postgres credentials used by the db and api services
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner
POSTGRES_DB=planner

# Signs login tokens. Use a long random value (at least 32 characters) anywhere but your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789

# Create demo@example.com / demo-password and a demo agency with a year of history on first start.
SEED_DEMO=true
