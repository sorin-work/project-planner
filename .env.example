# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5451
API_PORT=4411
WEB_PORT=5191
# The subnet of the stack and the fixed address of the web container in it, the one
# address the api takes X-Forwarded-For from. Change both if the subnet is taken.
#COMPOSE_SUBNET=172.28.40.0/24
#WEB_ADDRESS=172.28.40.10

# The page of the mail catcher, only with the "mail" profile (see below).
MAIL_UI_PORT=5192

# Postgres credentials used by the db and api services
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner
POSTGRES_DB=planner

# Signs login tokens. Use a long random value (at least 32 characters) anywhere but your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789

# Create demo@example.com / demo-password and a demo agency with a year of history on first start.
SEED_DEMO=true

# Serve the interactive API reference at /api/docs. For development: without this line it
# is off, and it should stay off on a host that is open to the internet. The page is
# third-party script on the address where the web app keeps the login token. The OpenAPI
# document at /api/openapi is served either way.
API_DOCS=true

# Optional services started with the rest on every "docker compose up": "mail" is
# the mail catcher for development, "backup" the daily database dumps.
COMPOSE_PROFILES=mail
#COMPOSE_PROFILES=mail,backup

# Mail for invitations and password reset links, here to the mail catcher. Without
# MAIL_HOST the app sends no mail and there are no reset links. For a real mail server
# set MAIL_HOST, MAIL_PORT (587), MAIL_USERNAME and MAIL_PASSWORD, and leave out
# MAIL_STARTTLS: the connection then has to be encrypted. MAIL_TLS=true is for port 465.
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_STARTTLS=DISABLED
MAIL_FROM=project-planner@localhost
# The address of the web app. Links in mails are built from it.
APP_URL=http://localhost:5191
# Set to true to let nobody sign up without the link of an invitation. An address with a
# mailed invitation needs its link either way.
INVITE_LINK_REQUIRED=false

# Folder on this machine the dumps are written to, and how many are kept.
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Seconds from one dump to the next. One day.
BACKUP_INTERVAL_SECONDS=86400

# age public keys (age1...), separated by spaces. When set, every dump and attachments
# archive is written encrypted, and only the encrypted file reaches the disk. Keep the
# private key somewhere else: a restore needs it, see "Backup and restore" in the README.
#BACKUP_ENCRYPT_TO=age1...
# A second folder on another disk or a mounted share that every finished dump is copied
# to and pruned in, like BACKUP_DIR.
#BACKUP_COPY_DIR=/mnt/nas/planner-backups
# An rclone remote for a bucket you host yourself (MinIO, Garage), and the folder with
# its rclone.conf. Needs the backup image built with BACKUP_PACKAGES=rclone.
#BACKUP_PACKAGES=rclone
#BACKUP_RCLONE_REMOTE=minio:planner-backups
#BACKUP_RCLONE_CONFIG=./rclone
# A copy that takes longer than this is stopped and counts as failed. One hour.
BACKUP_COPY_TIMEOUT_SECONDS=3600
# The api reads the backup status from here and mails the addresses in BACKUP_ALERT_EMAILS,
# the people who run this server, once when backups stop. Only accounts with one of those
# addresses see the status on the Settings page. Empty to leave the api out of it.
#BACKUP_STATUS_FILE=/backup-status/backup-status
#BACKUP_ALERT_EMAILS=ops@example.com
